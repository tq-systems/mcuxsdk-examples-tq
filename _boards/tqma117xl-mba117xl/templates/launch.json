{
  "inputs": [
    {
      "type": "pickString",
      "id": "app",
      "description": "choose your app",
      "options": [
        "canfd_flexcan_ping_pong_buffer_transfer",
        "eeprom_m24c64",
        "external_rtc",
        "flexcan_ping_pong_buffer_transfer",
        "flexspi_nor_polling_transfer",
        "hello_world",
        "led_blinky",
        "rtc",
        "temp_sensor_se97b"      
      ]
    }
  ],
  "configurations": [
    {
      "showDevDebugOutput": "both",
      "type": "cortex-debug",
      "request": "launch",
      "name": "Debug J-Link RAM",
      "cwd": "${workspaceFolder}",
      "servertype": "jlink",
      "device": "MIMXRT1176xxxA_M7",
      "interface": "jtag",
      "runToEntryPoint": "main",
      "executable": "${workspaceFolder}/mcuxsdk-examples-tq/build/${input:app}_cm7.elf",
      "serverArgs": [
        "-endian",
        "little",
        "-LocalhostOnly",
        "-speed",
        "4000"
      ],
      "postLaunchCommands": [
        "target remote localhost:50000",
        "monitor reset",
        "monitor halt",
        "load"
      ]
    },
  ]
}
