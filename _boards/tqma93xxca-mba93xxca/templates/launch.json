{
    "inputs": [
        {
            "type": "pickString",
            "id": "app",
            "description": "choose your app",
            "options": [
                "canfd_flexcan_ping_pong_buffer_transfer",
                "ethosu_apps_rpmsg",
                "flexcan_ping_pong_buffer_transfer",
                "hello_world",
                "rgpio_input_interrupt",
                "rgpio_led_output",
                "rpmsg_lite_pingpong_rtos_linux_remote"
            ]
        }
    ],
    "configurations": [
        {
            "showDevDebugOutput": "both",
            "type": "cortex-debug",
            "request": "launch",
            "name": "Debug J-Link RAM",
            "cwd": "${workspaceFolder}",
            "servertype": "jlink",
            "device": "MIMX9352_M33",
            "interface": "jtag",
            "runToEntryPoint": "main",
            "executable": "${workspaceFolder}/mcuxsdk-examples-tq/build/${input:app}_cm33.elf",
            "serverArgs": [
                "-endian",
                "little",
                "-LocalhostOnly",
                "-speed",
                "4000"
            ],
            "postLaunchCommands": [
                "target remote localhost:50000",
                "monitor reset",
                "monitor halt",
                "load"
            ]
        }
    ]
}
